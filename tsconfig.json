{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"declaration": true,
		"sourceMap": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"outDir": "dist",
		"rootDir": ".",
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": [
		"src",
		"tests",
		"scripts"
	],
	"exclude": [
		"scripts/issue-558-integration.ts",
		"scripts/runner-filesystem-grants-integration.ts"
	]
}
